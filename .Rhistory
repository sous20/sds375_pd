library(tidyverse)
library(dplyr)
library(lubridate)
library(tidyr)
data = read.csv("ny_pollution.csv.gz")
data$date = as.Date(data$date)
weekly_data <- data %>%
arrange(date) %>%
fill(pollution, .direction = "down") %>%   # carry last known pollution forward
mutate(week_start = floor_date(date, "week", week_start = 1)) %>%
group_by(week_start) %>%
summarise(
death = sum(death, na.rm = TRUE),
pollution = first(pollution)             # now every week has a value
)
cor(weekly_data$death, weekly_data$pollution)
